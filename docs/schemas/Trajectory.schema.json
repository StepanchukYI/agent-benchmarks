{
  "$defs": {
    "RunStatus": {
      "enum": [
        "completed",
        "timeout",
        "unrunnable",
        "error"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ScorerKind": {
      "enum": [
        "deterministic",
        "llm_judge",
        "state_diff",
        "schema",
        "exec",
        "privacy_check"
      ],
      "title": "ScorerKind",
      "type": "string"
    },
    "ScorerVerdict": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "default": "",
          "title": "Detail"
        },
        "kind": {
          "$ref": "#/$defs/ScorerKind"
        },
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "scorer_name": {
          "title": "Scorer Name",
          "type": "string"
        }
      },
      "required": [
        "scorer_name",
        "kind",
        "pass",
        "score"
      ],
      "title": "ScorerVerdict",
      "type": "object"
    },
    "Tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ],
      "title": "Tier",
      "type": "string"
    },
    "Totals": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        }
      },
      "title": "Totals",
      "type": "object"
    },
    "Turn": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "idx": {
          "minimum": 0,
          "title": "Idx",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_output": {
          "default": "",
          "title": "Model Output",
          "type": "string"
        },
        "prompt_delta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Delta"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "tool_calls": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "tool_returns": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tool Returns",
          "type": "array"
        },
        "vault_state_diff": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vault State Diff"
        }
      },
      "required": [
        "idx",
        "role"
      ],
      "title": "Turn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "harness": {
      "title": "Harness",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "prompt_template_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Template Hash"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scorer_verdicts": {
      "items": {
        "$ref": "#/$defs/ScorerVerdict"
      },
      "title": "Scorer Verdicts",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "tier": {
      "$ref": "#/$defs/Tier"
    },
    "tier_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier Hash"
    },
    "totals": {
      "anyOf": [
        {
          "$ref": "#/$defs/Totals"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "title": "Turns",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "model",
    "harness",
    "tier",
    "dataset_version",
    "started_at"
  ],
  "title": "Trajectory",
  "type": "object"
}
