{
  "$defs": {
    "IsolationInfo": {
      "additionalProperties": false,
      "description": "Record of how the runner isolated the operator's HOME from the benchmark agent.\n\nEmitted on run_start so the leaderboard can show isolation provenance\nalongside scores. Other runners emit isolation=None until they adopt\nclean-HOME isolation.",
      "properties": {
        "bare": {
          "title": "Bare",
          "type": "boolean"
        },
        "home": {
          "title": "Home",
          "type": "string"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "real_home_untouched": {
          "title": "Real Home Untouched",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "home",
        "real_home_untouched",
        "bare"
      ],
      "title": "IsolationInfo",
      "type": "object"
    },
    "ReasoningConfig": {
      "additionalProperties": false,
      "description": "Reasoning / thinking budget the model was instructed to use.\n\nSee `docs/result-sensitivity-axes.md` axis #1 \u2014 same model with\n`thinking=off` vs `thinking=high` differs 20-40% on reasoning-\nsensitive tasks. Both fields optional; runners that don't expose\nreasoning controls leave both None.",
      "properties": {
        "budget_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Tokens"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "off",
                "low",
                "medium",
                "high",
                "xhigh",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        }
      },
      "title": "ReasoningConfig",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "completed",
        "timeout",
        "unrunnable",
        "error"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SamplingConfig": {
      "additionalProperties": false,
      "description": "Sampling-knob values the model was called with.\n\nRecorded in trajectory `run_start` so the leaderboard can normalise\ncross-runner comparisons against the recommended defaults\n(temperature=0, top_p=1.0, max_output_tokens >= 4096, stream=False).\nSee `docs/result-sensitivity-axes.md` axes #2, #3, #10.",
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "stream": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_k": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "SamplingConfig",
      "type": "object"
    },
    "ScorerKind": {
      "enum": [
        "deterministic",
        "llm_judge",
        "state_diff",
        "schema",
        "exec",
        "privacy_check"
      ],
      "title": "ScorerKind",
      "type": "string"
    },
    "ScorerVerdict": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "default": "",
          "title": "Detail"
        },
        "kind": {
          "$ref": "#/$defs/ScorerKind"
        },
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "scorer_name": {
          "title": "Scorer Name",
          "type": "string"
        }
      },
      "required": [
        "scorer_name",
        "kind",
        "pass",
        "score"
      ],
      "title": "ScorerVerdict",
      "type": "object"
    },
    "Tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ],
      "title": "Tier",
      "type": "string"
    },
    "Totals": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        }
      },
      "title": "Totals",
      "type": "object"
    },
    "Turn": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "idx": {
          "minimum": 0,
          "title": "Idx",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_output": {
          "default": "",
          "title": "Model Output",
          "type": "string"
        },
        "prompt_delta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Delta"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "tool_calls": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "tool_returns": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tool Returns",
          "type": "array"
        },
        "vault_state_diff": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vault State Diff"
        }
      },
      "required": [
        "idx",
        "role"
      ],
      "title": "Turn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "harness": {
      "title": "Harness",
      "type": "string"
    },
    "isolation": {
      "anyOf": [
        {
          "$ref": "#/$defs/IsolationInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "model_context_window_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Context Window Tokens"
    },
    "output_tokens_used": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens Used"
    },
    "output_truncated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Truncated"
    },
    "prompt_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Label"
    },
    "prompt_template_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Template Hash"
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasoningConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sampling": {
      "anyOf": [
        {
          "$ref": "#/$defs/SamplingConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scorer_verdicts": {
      "items": {
        "$ref": "#/$defs/ScorerVerdict"
      },
      "title": "Scorer Verdicts",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "system_prompt_verbatim": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Prompt Verbatim"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "tier": {
      "$ref": "#/$defs/Tier"
    },
    "tier_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier Hash"
    },
    "totals": {
      "anyOf": [
        {
          "$ref": "#/$defs/Totals"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "turn_cap": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Cap"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "title": "Turns",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "model",
    "harness",
    "tier",
    "dataset_version",
    "started_at"
  ],
  "title": "Trajectory",
  "type": "object"
}
