{
  "$defs": {
    "AgentConfig": {
      "additionalProperties": false,
      "description": "Cross-submission knob snapshot for sensitivity-aware filtering.\n\nMirrors the per-run values in `Trajectory.sampling` /\n`Trajectory.reasoning`. Submission carries them too so the\nleaderboard can filter without re-opening the trajectory.\n\nSee `docs/result-sensitivity-axes.md` for the full inventory of\naxes (12 secondary axes; this captures the structural ones).",
      "properties": {
        "model_context_window_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Context Window Tokens"
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sampling": {
          "anyOf": [
            {
              "$ref": "#/$defs/SamplingConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "system_prompt_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Prompt Sha256"
        },
        "turn_cap": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Cap"
        }
      },
      "title": "AgentConfig",
      "type": "object"
    },
    "ReasoningConfig": {
      "additionalProperties": false,
      "description": "Reasoning / thinking budget the model was instructed to use.\n\nSee `docs/result-sensitivity-axes.md` axis #1 \u2014 same model with\n`thinking=off` vs `thinking=high` differs 20-40% on reasoning-\nsensitive tasks. Both fields optional; runners that don't expose\nreasoning controls leave both None.",
      "properties": {
        "budget_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Tokens"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "off",
                "low",
                "medium",
                "high",
                "xhigh",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        }
      },
      "title": "ReasoningConfig",
      "type": "object"
    },
    "SamplingConfig": {
      "additionalProperties": false,
      "description": "Sampling-knob values the model was called with.\n\nRecorded in trajectory `run_start` so the leaderboard can normalise\ncross-runner comparisons against the recommended defaults\n(temperature=0, top_p=1.0, max_output_tokens >= 4096, stream=False).\nSee `docs/result-sensitivity-axes.md` axes #2, #3, #10.",
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "stream": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_k": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "SamplingConfig",
      "type": "object"
    },
    "ScorerKind": {
      "enum": [
        "deterministic",
        "llm_judge",
        "state_diff",
        "schema",
        "exec",
        "privacy_check"
      ],
      "title": "ScorerKind",
      "type": "string"
    },
    "ScorerVerdict": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "default": "",
          "title": "Detail"
        },
        "kind": {
          "$ref": "#/$defs/ScorerKind"
        },
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "scorer_name": {
          "title": "Scorer Name",
          "type": "string"
        }
      },
      "required": [
        "scorer_name",
        "kind",
        "pass",
        "score"
      ],
      "title": "ScorerVerdict",
      "type": "object"
    },
    "Tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ],
      "title": "Tier",
      "type": "string"
    },
    "TrustTier": {
      "enum": [
        "self_reported",
        "verified",
        "official"
      ],
      "title": "TrustTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "registered_repo_id": {
      "title": "Registered Repo Id",
      "type": "string"
    },
    "scorer_verdicts": {
      "items": {
        "$ref": "#/$defs/ScorerVerdict"
      },
      "title": "Scorer Verdicts",
      "type": "array"
    },
    "source_commit_sha": {
      "title": "Source Commit Sha",
      "type": "string"
    },
    "source_repo": {
      "title": "Source Repo",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "tier": {
      "$ref": "#/$defs/Tier"
    },
    "trajectory_path": {
      "title": "Trajectory Path",
      "type": "string"
    },
    "trust_tier": {
      "$ref": "#/$defs/TrustTier"
    }
  },
  "required": [
    "id",
    "source_repo",
    "source_commit_sha",
    "registered_repo_id",
    "trajectory_path",
    "trust_tier",
    "submitted_at",
    "model",
    "tier",
    "dataset_version"
  ],
  "title": "Submission",
  "type": "object"
}
