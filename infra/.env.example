# =============================================================================
# agent-benchmarks production environment.
# Copy to infra/.env and fill in real values. NEVER commit infra/.env.
# =============================================================================

# ----- Postgres ---------------------------------------------------------------
# Strong password for the `ab` Postgres role. No default — compose refuses to
# start without it. Generate: openssl rand -base64 32
POSTGRES_PASSWORD=changeme-set-a-strong-password

# Full SQLAlchemy URL the server uses. Hostname `postgres` matches the compose
# service name on ab_net. Keep psycopg driver for SQLAlchemy 2.x.
DATABASE_URL=postgresql+psycopg://ab:${POSTGRES_PASSWORD}@postgres:5432/ab

# ----- GitHub OAuth (per ADR-007) --------------------------------------------
# Register an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be: https://${AB_DOMAIN}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- Session signing --------------------------------------------------------
# Used to sign httpOnly session cookies. Rotate => all users get logged out.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ----- Public hostname --------------------------------------------------------
# The domain Caddy will serve and provision TLS for. Examples:
#   ab.example.com   -> Caddy gets a real Let's Encrypt cert
#   ab.local         -> Caddy issues a local self-signed cert (homelab)
AB_DOMAIN=ab.local

# Base URL the SPA uses to talk to the API. Baked into the Vite build, so
# changing this requires rebuilding the ab-leaderboard image.
AB_API_BASE_URL=https://${AB_DOMAIN}/api/v1

# Comma-separated origin allowlist for the server's CORS middleware.
ALLOWED_ORIGINS=https://${AB_DOMAIN}

# ----- Server runtime tuning --------------------------------------------------
# Gunicorn worker count. Rule of thumb: 2*CPU + 1. Lower for small homelabs.
GUNICORN_WORKERS=4

# Trust X-Forwarded-* headers from Caddy. Required so request.client.host
# reflects the real client and not the proxy. Must be 1 in this topology.
AB_TRUST_PROXY=1

# Peer IPs allowed to send X-Forwarded-* headers that we'll trust. Used by
# Starlette's ProxyHeadersMiddleware (Python side). Default 127.0.0.1 only —
# tighten beyond what gunicorn accepts so even if a same-network container
# bypasses gunicorn's filter, Starlette won't honour its forwarded headers.
# Comma-separated. Use just the proxy's IP/range, not "*".
PROXY_TRUSTED_HOSTS=127.0.0.1

# Which peer IPs gunicorn trusts to set X-Forwarded-* headers (string passed to
# gunicorn's --forwarded-allow-ips). Default = localhost + RFC1918 ranges, which
# covers same-network docker proxies (Caddy lives in 172.16.0.0/12). Was '*' —
# do NOT use '*' here, it lets any container on the bridge spoof client IPs and
# bypass per-IP rate limiting. Comma-separated CIDR/IP list.
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Gunicorn listen address. Default 0.0.0.0:8000 because Caddy is in a separate
# container and reaches us across ab_net. Override only if you know the
# topology (e.g. host-network deployments).
# GUNICORN_BIND=0.0.0.0:8000

# Per-IP rate limit (requests / minute). 0 disables. In-memory, single-instance.
RATE_LIMIT_PER_MINUTE=120

# Log format: "json" (structured, recommended for prod) or "text" (human).
LOG_FORMAT=json

# ----- Production safety gates -----------------------------------------------
# IS_PRODUCTION=1 hardens the server: refuses to start if AB_TEST_AUTH=1.
IS_PRODUCTION=1
# AB_TEST_AUTH=1 enables test-mode auth bypass (X-Test-User header). MUST be 0
# in production. Combined with IS_PRODUCTION=1, the server will refuse to boot.
AB_TEST_AUTH=0

# ----- Alert delivery (SMTP) --------------------------------------------------
# Used by ab_server.alerts.delivery.dispatch_alert when an AlertRule's
# channels include {"type": "email", "to": "..."}. Empty SMTP_HOST disables
# email delivery (channels are skipped, eval not affected). Webhook channels
# work without any SMTP config.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# SMTP_USE_SSL=0
# SMTP_STARTTLS=1

# ----- Optional ---------------------------------------------------------------
# Skip pg_isready wait at server boot (debug only).
# AB_SKIP_DB_WAIT=0
# Skip alembic upgrade head at server boot (debug / read replicas).
# AB_SKIP_MIGRATIONS=0
# Override fetcher cache path inside the container (volume is mounted at /app/.cache).
# FETCHER_CACHE_DIR=/app/.cache/agent-benchmarks/fetcher

# ----- Pre-built image deployment --------------------------------------------
# Used by infra/docker-compose.deploy.yml to pull images from ghcr.io instead
# of building from source. Ignored by infra/docker-compose.prod.yml.
#
# GHCR owner name (lowercase). For this repo: stepanchukyi.
IMAGE_OWNER=stepanchukyi
#
# Image tag to pull. Recommended values:
#   sha-<git_sha>  pin a specific commit build (best for prod)
#   v0.X.Y         pin a specific release tag
#   main           auto-update channel (tip of main)
#   latest         alias for tip of main (NOT latest release — read carefully)
IMAGE_TAG=main
